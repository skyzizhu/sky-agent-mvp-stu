# 复制为 .env 并填入你拿到的云端模型信息
# 三要素缺一不可；模型必须支持 tool calling（function calling）
LLM_API_KEY=sk-xxxx
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_MODEL=deepseek-chat

# 可选：MCP 服务器配置（JSON数组，多个server逗号分隔；不填则不启用MCP）
# 示例（文件系统server，限定在项目目录内）：
# MCP_SERVERS=[{"name":"fs","command":"npx","args":["-y","@modelcontextprotocol/server-filesystem","/你的/目录"]}]

# 可选：Tavily 搜索 API key（配置后搜索自动优先走 Tavily，免费 ddgs 降级备用）
# TAVILY_API_KEY=tvly-xxxx

# ===== 邮件发送（send_report 危险工具，可选）=====
# 三项填齐 → send_report 真实发送；留空 → 模拟发送（sent(mock)）
# 网易163：网页登录 mail.163.com → 设置 → POP3/SMTP/IMAP → 开启 SMTP 服务
#   → 按提示用手机发短信 → 页面显示授权码（只显示一次）
# SMTP_HOST=smtp.163.com
# SMTP_PORT=465
# SMTP_USER=你的完整邮箱@163.com
# SMTP_AUTH_CODE=授权码（不是邮箱登录密码）
